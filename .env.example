# Provisiona Atvos — Environment Configuration
# Copy this file to .env and fill in the values.

# SAP S/4HANA Connection
VITE_SAP_BASE_URL=https://sap-s4hana.atvos.com/sap/opu/odata/sap/
VITE_SAP_CLIENT=100
VITE_SAP_SYSTEM_ID=PRD

# Feature Flags
VITE_FEATURE_TOUCHLESS_AUTO=true
VITE_FEATURE_IDEMPOTENCY_GUARD=true
VITE_FEATURE_CPC25_STRICT_MODE=false
VITE_FEATURE_ACTIVE_LEARNING=true

# Application Mode
VITE_APP_MODE=demo
VITE_APP_VERSION=1.0.0
